# ─── Postgres (elige local O Supabase) ─────────────────────────────────────
# Local (Docker compose "db"): usuario/clave de ese contenedor
DB_NAME=soldmate
DB_USER=postgres
DB_PASSWORD=postgres

# Supabase Postgres: en el dashboard, Settings → Database → Connection string (URI o JDBC).
# El host directo db.<ref>.supabase.co suele ser solo IPv6; en Docker (p. ej. Docker Desktop)
# a veces falla la resolución/conexión. Para backend en contenedor, usa el Session pooler
# (host tipo aws-0-<region>.pooler.supabase.com, puerto 5432, usuario postgres.<ref>).
# Descomenta y pega la cadena exacta del dashboard (no inventes el host):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.TU_REF
# SPRING_DATASOURCE_PASSWORD=tu_password_de_database

# JWT (replace in real environments)
JWT_SECRET=change-this-with-at-least-32-characters

# CORS (frontend origins permitidos, separados por coma)
# Ejemplo producción: https://soldmate.vercel.app,https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:23000

# Supabase (Storage + misma cuenta que la DB si usas su Postgres)
# URL raíz del proyecto: https://xxxx.supabase.co — sin /rest/v1 ni /storage/v1
SOLDMATE_SUPABASE_URL=https://your-project.supabase.co
SOLDMATE_SUPABASE_ANON_KEY=your-anon-key
# Recomendado en backend/producción para evitar bloqueos por RLS en subidas.
SOLDMATE_SUPABASE_SERVICE_KEY=your-service-role-key
# Nombre del bucket en Storage (créalo en el dashboard → Storage → New bucket).
# Márcalo como PÚBLICO si quieres abrir la URL directamente sin firma.
# Por defecto: incidents (se usa tanto para fotos de incidencias como documentos)
SOLDMATE_SUPABASE_BUCKET=incidents

